# URL of the deployed Isogram FastAPI (see api/main.py). Read server-side
# only — every fetch happens in a React Server Component, never in the
# browser, so this does NOT need a NEXT_PUBLIC_ prefix (see lib/api.ts).
API_BASE_URL=http://localhost:8000

# Identifies the dashboard's own server to the API so its traffic is not counted against the anonymous
# per-IP limit of Vercel's shared addresses. Must equal one entry of INTERNAL_API_KEYS on the API (Render).
# Server-side only: never a NEXT_PUBLIC_ variable. Generate with: python3 -c "import secrets; print('dash_' + secrets.token_urlsafe(32))"
API_KEY=
