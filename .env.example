# Supabase (ingestion worker + api both need these)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Arc mainnet RPC — confirmed open, no credentials needed (see
# docs/decisions/ADR-001-data-source.md). Override only if you've set up a
# dedicated QuickNode/Alchemy endpoint after hitting rate limits.
ARC_RPC_URL=https://rpc.mainnet.arc.io
COINGECKO_PRO_API_KEY=your_coingecko_pro_api_key_here
ADMIN_API_KEY=admin-api-key-123
ADMIN_DASHBOARD_PASSWORD=y0ur_p@ssw0rd


# Ingestion tuning (optional — sane defaults in worker.py)
START_BLOCK=
# 100 is conservative given current per-block processing speed (~0.3-0.5
# blocks/sec, measured against Arc's real ~2 blocks/sec) — see docs/BUGS.md
# for the known backlog risk and the fix (batch RPC receipt calls).
MAX_BLOCKS_PER_RUN=100
# Telegram bot (bot/ only)
TELEGRAM_BOT_TOKEN=
