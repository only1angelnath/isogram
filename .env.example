# Copy to .env (never commit real values).

# --- Database (ingestion, scoring and api all need these) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Arc mainnet RPC ---
# The free shared endpoint is last in the pool. Dedicated endpoints are tried first;
# any left unset are skipped.
ARC_RPC_URL=https://rpc.mainnet.arc.io
ALCHEMY_ARC_RPC_URL=
DRPC_ARC_RPC_URL=
QUICKNODE_ARC_RPC_URL=
BLOCKDAEMON_ARC_RPC_URL=
BLOCKDAEMON_API_KEY=

# --- Discovery and market data ---
COINGECKO_PRO_API_KEY=your_coingecko_pro_api_key_here

# --- Admin desk ---
# ADMIN_API_KEY gates /admin/* on the API and signs the dashboard session cookie.
# Use long random values for both.
ADMIN_API_KEY=change-me
ADMIN_DASHBOARD_PASSWORD=change-me

# --- API access (optional) ---
# Comma-separated keys that get the internal rate-limit tier (the dashboard server's key).
INTERNAL_API_KEYS=
# Dashboard: where the API lives, and the internal key it sends.
API_BASE_URL=http://localhost:8000
API_KEY=

# --- Ingestion tuning (optional; the workflow sets these in CI) ---
START_BLOCK=
# Blocks in flight; raise gradually and watch for 429s.
RPC_CONCURRENCY=4
BATCH_BLOCKS=500
MAX_BLOCKS_PER_RUN=400000
RUN_TIME_BUDGET_SECONDS=3300
FOLLOW_TIP=true
TIP_POLL_SECONDS=10
